# LUNARIS 桌面端凭证配置示例
#
# 真实后端 sidecar 打包成 PyInstaller 二进制后，无法读取仓库根目录的 .env
# （frozen 下 __file__ 指向临时解包目录）。因此桌面端的密钥需放在
# **数据目录** 下，由 backend/app/config.py 在 LUNARIS_DATA_DIR 模式下加载：
#
#   <数据目录>/config/.env   ← 推荐
#   <数据目录>/.env          ← 也可
#
# macOS 下数据目录默认是：
#   ~/Library/Application Support/com.lunaris.voice-analyzer/data
# 即把本文件复制为：
#   ~/Library/Application Support/com.lunaris.voice-analyzer/data/config/.env
# 并填入真实值。仓库根 .env（dev 模式）优先级更高，二者互不影响。
#
# 复制后 chmod 600，切勿提交真实密钥。

# 阿里云 DashScope（真实 ASR / LLM 总结）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
ASR_PROVIDER=aliyun
ALIYUN_ASR_MODEL=fun-asr
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# LLM 总结
LLM_PROVIDER=dashscope
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 真实 ASR 公网回源地址（阿里云需要能访问到音频文件的公网 URL）
# 桌面端 127.0.0.1 本地文件云端不可达 —— 见 docs/desktop-beta-test.md 已知限制。
# dev 期可用 localtunnel / ngrok / Cloudflare Tunnel 暴露。
PUBLIC_BASE_URL=https://your-tunnel.example.com
